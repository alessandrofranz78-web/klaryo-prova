{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vite/client"],
    "useDefineForClassFields": true
  },
  "include": ["domain", "server", "src", "static-demo", "tests", "vite.config.ts", "vite.static-demo.config.ts", "vitest.config.ts"]
}
